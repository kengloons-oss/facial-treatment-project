@model MembershipVM

@{
	Layout = "_StaffLayout";
	ViewBag.Title = "Membership | " + Helpers.FormatId("ML", Model.Id);

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Membership", "/Membership/List"),
		new KeyValuePair<string, string>("Detail", null)
	};

	bool isManager = Helpers.isManager();
}

<form method="post" class="" enctype="multipart/form-data">
	<div class="container">
		<div class="columns">

			<!-- left-side -->
			<div class="formformat column col-6 col-sm-12 card my-single-card">
				<div asp-validation-summary="ModelOnly"></div>

				<div class="card-header">
					<div class="card-title h5">
						<!-- Back Button -->
						<button class="topleft-back" type="button" data-get="/Membership/List" uk-tooltip="title: Back to Previous Section; pos: top-left;"><i class="fa-solid fa-arrow-left"></i></button> &nbsp;
						<!-- Page Title -->
						Membership Level @Helpers.FormatId("ML", Model.Id)
					</div>
				</div>

				<div class="card-body my-pagecard-body">
					<!-- Icon -->
					<div class="form-group">
						<label class="upload">
							<img src="@(!string.IsNullOrEmpty(@Model.Icon) ? "/images/membership/" + @Model.Icon : "/images/membership/defaultProfile.png")">

							<label asp-for="Icon" class="form-label" style="display:none;"></label>

							@if (isManager)
							{
								<div class="upload-insidelayout columns col-gapless">
									<div class="column col-2">
										<button class="capture-photo-btn " type="button" uk-tooltip="title: Drop or select photo; pos: top-right">
											<i class="fa-solid fa-camera-retro"></i>
										</button>
									</div>

									<div class="column col-10">
										<div class="upload-inputbox">
											<label for="file-upload" class="file-upload-label">
												<i class="fa-solid fa-cloud-arrow-up"></i> Attach icon by dropping it here, or <span class="select-text">selecting one</span>.
											</label>
											<input asp-for="Upload_image" id="file-upload" type="file" accept="image/jpeg,image/png,image/jpg" class="file-input">
										</div>
									</div>
								</div>
							}

						</label>
						<span asp-validation-for="Upload_image" class="form-input-hint error-message"></span>
					</div>

					<div class="uk-grid">
						<div class="uk-width-1-3">
							<!-- Membership Level Id -->
							<div class="form-group">
								<label asp-for="Id" class="form-label">Membership Level Id:</label>
								<div style="padding-bottom:0.5rem;">@Helpers.FormatId("ML", Model.Id)</div>
							</div>
						</div>
					</div>

					<!-- Level -->
					<div class="form-group">
						<label asp-for="Level" class="form-label">Level:</label>
						@if (isManager)
						{
							<input asp-for="Level" type="number" class="form-input level-d" min="1" max="99" data-trim />
							<span asp-validation-for="Level" class="form-input-hint error-message"></span>
						}
						else
						{
							<div class="fake-input">@Model.Level</div>
						}

					</div>

					<!-- Min_expense -->
					<div class="form-group">
						<label asp-for="Min_expense" class="form-label">Minimum Expense (RM):</label>
						@if (isManager)
						{
							<input asp-for="Min_expense" type="number" class="form-input minExpense" min="0" max=" 999999.99" step="0.01" placeholder="Eg. 0.01" data-trim />
							<span asp-validation-for="Min_expense" class="form-input-hint error-message"></span>
						}
						else
						{
							<div>@Model.Min_expense</div>
						}

					</div>

					<!-- Discount_rate -->
					<div class="form-group">
						<label asp-for="Discount_rate" class="form-label">Discount Rate:</label>

						@if (isManager)
						{
							<input asp-for="Discount_rate" type="number" class="form-input discountRate" min="0" max=" 1" step="0.01" placeholder="Eg. 0.01" data-trim />
							<span asp-validation-for="Discount_rate" class="form-input-hint error-message"></span>
						}
						else
						{
							<div>@Model.Discount_rate</div>
						}
						
					</div>

					@if(isManager){
						<!-- Buttons -->
						<div class="text-right" style="padding-top:16px;">
							<button type="reset" class="btn btn-secondary">Reset</button>
							<button id="submitButton" type="submit" class="btn btn-primary">Save</button>
						</div>
					}
					
				</div> <!-- end card-body -->
			</div><!-- end left-side -->
		</div>
	</div>
</form>

@section foot {
	<script>
		var bar = document.getElementById('js-progressbar');
		let originalLevel = '@(Html.Raw(Model.Level))';

		$(document).ready(function () {

			$('input').on('blur input', function () {
				if ($(this).hasClass('level-d')) {
					console.log('CompositionEvent to trigger level-d');

					var input = $(this).val();
					var inputElement = $(this);

					let err = validateNumber(input, 1, 99, true, "Membership Level"); // Use `let` instead of `const`

					if (err != null) {
						showError(inputElement, err);
						levelErr = true;
					}
					else if(input != originalLevel) {
						err = checkLevelExist(input, function (err) {
							if (err != null) {
								showError(inputElement, err);
								levelErr = true;
							}
							else {
								clearError(inputElement);
								levelErr = false;
							}
						});

					}
					else {
						clearError(inputElement);
						levelErr = false;
					}
				}
			});

			// Form submit
			$('form').submit(function (event) {
				event.preventDefault();

				// Trigger blur event to check and display
				$('.level-d, .minExpense, .discountRate').trigger('blur');

				// Add a short delay to make sure the blur event is processed
				setTimeout(() => {
					// Check for form errors before submission
					if (!levelErr && !minExpenseErr && !discountRateErr) {

						// Submit the form when all field is valid
						HTMLFormElement.prototype.submit.call(this);
					}
					else {
					   console.log("levelErr: " + levelErr);
					   console.log("minExpenseErr: " + minExpenseErr);
					   console.log("discountRateErr: " + discountRateErr);
					}
				}, 100);
			});
		});

		UIkit.upload('.js-upload', {

			url: '',
			multiple: true,

			beforeSend: function () {
				console.log('beforeSend', arguments);
			},
			beforeAll: function () {
				console.log('beforeAll', arguments);
			},
			load: function () {
				console.log('load', arguments);
			},
			error: function () {
				console.log('error', arguments);
			},
			complete: function () {
				console.log('complete', arguments);
			},

			loadStart: function (e) {
				console.log('loadStart', arguments);

				bar.removeAttribute('hidden');
				bar.max = e.total;
				bar.value = e.loaded;
			},

			progress: function (e) {
				console.log('progress', arguments);

				bar.max = e.total;
				bar.value = e.loaded;
			},

			loadEnd: function (e) {
				console.log('loadEnd', arguments);

				bar.max = e.total;
				bar.value = e.loaded;
			},

			completeAll: function () {
				console.log('completeAll', arguments);

				setTimeout(function () {
					bar.setAttribute('hidden', 'hidden');
				}, 1000);

				// alert('Upload Completed');
			}

		});
	</script>
}