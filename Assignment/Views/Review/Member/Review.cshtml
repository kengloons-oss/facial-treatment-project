@model AppointmentReviewVM

@{
	ViewBag.Title = "Appointment | Review";

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Appointment", "/Appointment/Calendar"),
		new KeyValuePair<string, string>("Review", null)
	};

	var reviewItems = ViewBag.Appointment.AppointmentReviews;
}



<div class="container">
	<div class="columns">
		<!-- LEFT -->
		<div class="column col-5">
			<!-- Appointment Detail -->
			<div class="appointment-container">
				<!-- Basic Information -->
				<div class="form-horizontal">
					<h2>Appointment @ViewBag.Appointment.Code</h2>

					<div class="form-group">
						<label class="form-label col-3">Appointment ID:</label>
						<div class="col-9">
							<span class="form-input">@ViewBag.Appointment.Code</span>
						</div>
					</div>

					<div class="form-group">
						<label class="form-label col-3">Package Name:</label>
						<div class="col-9">
							<span class="form-input">@ViewBag.Appointment.Title</span>
						</div>
					</div>

					<div class="form-group">
						<label class="form-label col-3">Staff In Charge:</label>
						<div class="col-9">
							<span class="form-input">@ViewBag.Appointment.Staff.Person.Name</span>
						</div>
					</div>

					<div class="form-group">
						<label class="form-label col-3">Room ID:</label>
						<div class="col-9">
							<span class="form-input">@ViewBag.Appointment.Room.Code</span>
						</div>
					</div>

					<div class="form-group">
						<label class="form-label col-3">Room Name:</label>
						<div class="col-9">
							<span class="form-input">@ViewBag.Appointment.Room.Name</span>
						</div>
					</div>

					<div class="form-group">
						<label class="form-label col-3">Date:</label>
						<div class="col-9">
							<span class="form-input">@Helpers.FormatDate(ViewBag.Appointment.Start_datetime)</span>
						</div>
					</div>

					<div class="form-group">
						<label class="form-label col-3">Time:</label>
						<div class="col-9">
							<span class="form-input">
								@Helpers.FormatDateTime(ViewBag.Appointment.Start_datetime) -
								@Helpers.FormatDateTime(ViewBag.Appointment.End_datetime)
							</span>
						</div>
					</div>
					<div class=" text-right">
						<!-- Service Included - Modal Trigger -->
						<br />
						<button class="btn  " onclick="document.getElementById('servicesModal').classList.add('active')">
							View Services Included
						</button>
						<!-- Previous Reviews - Modal Trigger2 --><!-- Existing Review Records -->
						<button class="btn btn-primary" onclick="document.getElementById('reviewsModal').classList.add('active')">
							View Previous Reviews
						</button>
					</div>
					<!-- Service Included - Modal Structure -->
					<div class="modal" id="servicesModal">
						<a class="modal-overlay" aria-label="Close" onclick="document.getElementById('servicesModal').classList.remove('active')"></a>
						<div class="modal-container" style="height:75%;">
							<div class="modal-header">
								<a class="btn btn-clear float-right" aria-label="Close" onclick="document.getElementById('servicesModal').classList.remove('active')"></a>
								<h3 class="modal-title">Services Included</h3>
							</div>
							<div class="modal-body">
								<div class="content">
									@foreach (var opts in ViewBag.Appointment.OrderPackageTreatment.OrderPackageTreatmentServices)
									{
										var servicePhoto = ((List<ServicePhoto>)opts.Service.ServicePhotos).Where(sp => sp.Type == 1).FirstOrDefault();
										var serviceName = servicePhoto != null ? servicePhoto?.Path : "../package/defaultImage.png";

										<div class="service-item review_card" style="background-color:#8bd4ff; margin-bottom:20px;">
											<img src="/images/service/@serviceName" alt="@opts.Service.Name" class="service-img" style="width:80px; height:80px;"/>
											<strong>Service Name:</strong> @opts.Service.Name<br />
											<strong>Service Duration:</strong> @opts.Duration hour(s)<br />
											<strong>Service Description:</strong> @opts.Service.Description<br />
										</div>
									}
								</div>
							</div>
							<div class="modal-footer">
								<button class="btn btn-primary" onclick="document.getElementById('servicesModal').classList.remove('active')">
									Close
								</button>
							</div>
						</div>
					</div>
					<!-- Previous Reviews - Modal Structure2 -->
					<div class="modal modal-lg" id="reviewsModal">
						<a class="modal-overlay" aria-label="Close" onclick="document.getElementById('reviewsModal').classList.remove('active')"></a>
						<div class="modal-container" style="height:90%;">
							<div class="modal-header">
								<a class="btn btn-clear float-right" aria-label="Close" onclick="document.getElementById('reviewsModal').classList.remove('active')"></a>
								<h3 class="modal-title">Previous Reviews</h3>
							</div>
							<div class="modal-body">
								<div class="content reviews-container" style="">
									@if (reviewItems != null && reviewItems.Count > 0)
									{
										foreach (var review in reviewItems)
										{
											<div class="review_card review-item" data-id="@review.Id">
												<!-- Review Details -->
												<div class="review-item-detail-container">
													<!-- Star Rate -->
													<div>
														<text>Star Rating: </text>
														@for (int i = 0; i < 5; i++)
														{
															if (i < review.Star)
															{
																<i class="fas fa-star" style="color: gold;"></i>
															}
															else
															{
																<i class="far fa-star" style="color: gold;"></i>
															}
														}
													</div>

													<!-- Comment -->
													<div>
														<label>Comment: </label>
														<p>@review.Comment</p>
													</div>
												</div>

												<!-- Review Photos -->
												@if (review.ReviewPhotos != null && review.ReviewPhotos.Count > 0)
												{
													<div class="review-item-photos-container">
														@foreach (var reviewPhoto in review.ReviewPhotos)
														{
															<img src="/images/review/@reviewPhoto.Path" class="prev-comment-img" />
														}
													</div>
												}

												<!-- Review Date -->
												<label>Created Date: @Helpers.FormatDate(review.Comment_date)</label>
											</div>
										}
									}
									else
									{
										<div class="empty">
											<div class="empty-icon">
												<i class="fa-solid fa-comments"></i>
											</div>
											<p class="empty-title h5">No Reviews Yet</p>
											<p class="empty-subtitle">Let's write down your thoughts now!</p>
										</div>
									}
								</div>
							</div>
							<div class="modal-footer">
								<button class="btn btn-primary" onclick="document.getElementById('reviewsModal').classList.remove('active')">
									Close
								</button>
							</div>
						</div>
					</div>

				</div>

			</div>
		</div>
		<!-- RIGHT -->
		<div class="column col-6 " style="margin-left:1rem;">
			<!-- New Appointment Review Form -->
			<div class="review-form-container">
				<h2>Add New Review</h2>
				<form enctype="multipart/form-data">
					<div asp-validation-summary="ModelOnly"></div>
					<input type="hidden" asp-for="AppointmentId" value="@Model.AppointmentId" />
					<div class="columns">
					<div class="column col-6">
						<!-- Review Photos -->
						<div class="review-form-photo">
							<label class="upload">
								<!-- Upload Image Preview -->
									<div class="image-preview-container">
										<div class="image-preview-item" style="width:100px; height:100px;">
											<img src="/images/package/defaultImage.png" class="up-cover-img" style="width:100px; height:100px;">
									</div>
								</div>

								<label asp-for="Upload_photos" class="form-label" style="display:none;"></label>

								<div class="upload-insidelayout columns col-gapless">
									@* <div class="column col-2"> *@
									@* 	<button class="capture-photo-btn " uk-tooltip="title: Capture Image by Camera; pos: top-right"> *@
									@* 		<i class="fa-solid fa-camera-retro"></i> *@
									@* 	</button> *@
									@* </div> *@
									<div class="column col-10">
										<div class="upload-inputbox adjust-upload-inputbox">
											<label for="file-upload" class="file-upload-label">
												<i class="fa-solid fa-cloud-arrow-up"></i> Attach photos by dropping them here, or <span class="select-text">selecting multiple</span>.
											</label>
											<input asp-for="Upload_photos" id="file-upload" type="file" accept="image/jpeg,image/png,image/jpg" class="file-input" multiple="multiple">
										</div>
									</div>
								</div>
							</label>
							<span asp-validation-for="Upload_photos" class="form-input-hint error-message"></span>
						</div>
					</div>

					<div class="column col-6" style="margin-left:-2rem;">
						<!-- Star Rate -->
						<div class="review-form-star">
							<label>How was our services? &#x1FAE3;</label>

							<div class="star-range">
								<i class="far fa-star" style="color: gold;"></i>
								<i class="far fa-star" style="color: gold;"></i>
								<i class="far fa-star" style="color: gold;"></i>
								<i class="far fa-star" style="color: gold;"></i>
								<i class="far fa-star" style="color: gold;"></i>
							</div>
							<input type="hidden" asp-for="Star" />
							<span asp-validation-for="Star" class="form-input-hint error-message"></span>
						</div>

						<!-- Comment Section -->
						<div class="form-group">
							<label asp-for="Comment" class="form-label">Comment:</label>
							<textarea id="comment" asp-for="Comment" class="form-input"
									  placeholder="Let's share your thoughts on our service!" rows="5" cols="50" data-trim>
						</textarea>
							<span asp-validation-for="Comment" class="form-input-hint text-error"></span>
							<div class="form-group">
								<label class="form-checkbox">
									<input type="checkbox" id="anonymous-checkbox" asp-for="Anonymous">
									<i class="form-icon"></i> Share Anonymously
								</label>
							</div>
						</div>
						<!-- Reset & Submit Button -->
						<div class="text-right" style="padding-top:16px;">
							<button type="reset" class="btn btn-secondary">Reset</button>
							<button type="submit" class="btn btn-primary">Submit</button>
						</div>
					</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section foot {
	<script>
		var star = 0;
		var review_image_upload = [];
		var starErr = false;
		var commentErr = false;
		var photoErr = false;

		// back button
		function back() {
            history.back();
        }

		// hover star
		$('.star-range i').on('mouseover', function() {
			var index = $(this).index();

			// Temporarily change the stars up to the hovered one to filled
			$('.star-range i').each(function(i) {
				if (i <= index) {
					$(this).removeClass('far fa-star').addClass('fas fa-star');
				} else {
					$(this).removeClass('fas fa-star').addClass('far fa-star');
				}
			});
		}).on('mouseout', function() {
			$('.star-range i').each(function(i) {
				if (i <= star - 1) {
					$(this).removeClass('far fa-star').addClass('fas fa-star');
				} else {
					$(this).removeClass('fas fa-star').addClass('far fa-star');
				}
			});
		});

		// select star
		$('.star-range i').on('click', function() {
			var index = $(this).index();
			console.log(index);

			$('.star-range i').each(function (i) {
				if (i <= index) {
					$(this).removeClass('far fa-star').addClass('fas fa-star');
				} else {
					$(this).removeClass('fas fa-star').addClass('far fa-star');
				}
			});

			// update star data
			star = index + 1;
			$('[name="Star"]').val(star);

			validateStar();
		});

		// upload photo
		$('#file-upload').on('change', function(e) {
			const f = e.target.files;
			const imgPrevContainer = $('.image-preview-container');

			// handle when no file uploaded
			if (!f || f.length === 0) {
				imgPrevContainer.empty();

				// append image preview to preview container
				review_image_upload.forEach((image, index) => {
					const imgItem = document.createElement('div');
					imgItem.className = "image-preview-item";

					const img = document.createElement('img');
					img.src = URL.createObjectURL(image);
					img.onload = () => URL.revokeObjectURL(img.src);

					const removeBtn = document.createElement('button');
					removeBtn.className = "remove-img-btn";
					removeBtn.textContent = "Remove";
					removeBtn.setAttribute('data-index', index);

					imgItem.appendChild(img);
					imgItem.appendChild(removeBtn);
					imgPrevContainer.append(imgItem);
				});
				return;
			}

			// check whether upload images more than 5
			if (review_image_upload.length + f.length > 5) {
				Swal.fire({
					title: "Maximum number of review images reached",
					text: `You can only upload a maximum of 5 images. Currently, ${review_image_upload.length} uploaded.`,
					icon: 'error',
					showDenyButton: false,
					showCancelButton: false,
					confirmButtonText: "OK"
				});
				e.target.value = '';
				return;
			}

			// clear image preview container
			imgPrevContainer.empty();

			// check whether current upload image more than 0
			if (f.length > 0) {
				// validate images + append upload images into array
				Array.from(f).forEach((file, index) => {
					if (!file.type.startsWith('image/')) {
						showError($('.upload'), 'Only JPG, PNG and JPEG photo is allowed.');
						e.target.value = '';
						photoErr = true;
					} else if (file.size > 3 * 1024 * 1024) {
						showError($('.upload'), 'Photo size cannot more than 3MB.');
						e.target.value = '';
						photoErr = true;
					} else {
						review_image_upload.push(file);
						clearError($('.upload'));
						photoErr = false;
					}
				});

				// append image preview to preview container
				review_image_upload.forEach((image, index) => {
					const imgItem = document.createElement('div');
					imgItem.className = "image-preview-item";

					const img = document.createElement('img');
					img.src = URL.createObjectURL(image);
					img.onload = () => URL.revokeObjectURL(img.src);

					const removeBtn = document.createElement('button');
					removeBtn.className = "remove-img-btn";
					removeBtn.textContent = "Remove";
					removeBtn.setAttribute('data-index', index);

					imgItem.appendChild(img);
					imgItem.appendChild(removeBtn);
					imgPrevContainer.append(imgItem);
				});
			}
		});

		// remove photo
		$(document).on('click', '.remove-img-btn', function(e) {
			e.preventDefault();

			const image_item_container = $(this).closest('.image-preview-container');
			const image_index = $(this).data('index');
			const image_item = $(this).closest('.image-preview-item');

			image_item.remove();

			$('.image-preview-item').each((index, element) => {
				$(element).find('.remove-img-btn')
					.data('index', index)
					.attr('data-index', index)
			});

			review_image_upload.splice(image_index, 1);
			updateFileInput();

			if (review_image_upload.length == 0) {
				const default_image_item = document.createElement('div');
				default_image_item.className = "image-preview-item";

				const default_image = document.createElement('img');
				default_image.src = "/images/package/defaultImage.png";
				default_image.className = "up-cover-img";

				default_image_item.appendChild(default_image);
				image_item_container.append(default_image_item);
			}
		});

		// validate comment
		$('[name="Comment"]').on('blur input', function() {
			var comment = $(this).val();
			console.log(comment.length);

			if (comment == null || comment == '') {
				console.log('1');
				showError($('[name="Comment"]'), 'Comment should not be empty.');
				commentErr = true;
			} else if (comment.length > 300) {
				console.log('2');
				showError($('[name="Comment"]'), 'Comment length should not more than 300 characters.');
				commentErr = true;
			} else {
				console.log('3');
				clearError($('[name="Comment"]'));
				commentErr = false;
			}
		});

		// validate star
		function validateStar() {
			if (star == 0) {
				showError($('[name="Star"]'), 'Star must between 1 and 5 only.');
				starErr = true;
			} else {
				clearError($('[name="Star"]'));
				starErr = false;
			}
		}

		// submit form
		$('[type="submit"]').on('click', function(e) {
			e.preventDefault();

			var formData = new FormData(e.target.form);

			validateStar();
			$('[name="Comment"]').trigger('blur');

			if (starErr || commentErr || photoErr) {
				return;
			}

			$.ajax({
				type: 'POST',
				url: '/Review/Create',
				data: formData,
				contentType: false,
				processData: false,
				success: function(res) {
					if (res.result) {
						Swal.fire({
							title: res.success_title,
							text: res.success_msg,
							icon: "success", // Options: 'success', 'error', 'warning', 'info', 'question'
							showDenyButton: false,
							showCancelButton: false,
							confirmButtonText: "Yes"
						}).then((result) => {
							window.location.reload();
						});
					} else {
						Swal.fire({
							title: res.error_title,
							text: res.error_msg,
							icon: "error", // Options: 'success', 'error', 'warning', 'info', 'question'
							showDenyButton: false,
							showCancelButton: false,
							confirmButtonText: "Yes"
						});
					}
				},
				error: function (xhr, status, error) {
					console.log('Error:', error);
					console.log(xhr.responseText);
				}
			});
		});

		function updateFileInput() {
			const dataTransfer = new DataTransfer();

			review_image_upload.forEach((image) => {
				dataTransfer.items.add(image);
			});

			$('#file-upload')[0].files = dataTransfer.files;
		}
	</script>
}