@model MemberPersonVM

@{
	Layout = "_StaffLayout";
	ViewBag.Title = "Member | " + Model.Member.Code;

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Member", "/Member/List"),
		new KeyValuePair<string, string>("Detail", null)
	};

	List<SelectListItem> statuses = new List<SelectListItem>{
		new SelectListItem { Value = "1", Text = "Active" },
		new SelectListItem { Value = "0", Text = "Inactive" },
	};
}

<form method="post" class="" enctype="multipart/form-data">
	<div class="container card my-pagecard">
		<!-- container card (got border line) -->
		<div class="columns">

			<!-- left-side -->
			<div class="formformat column col-6 col-sm-12">
				<div asp-validation-summary="ModelOnly"></div>

				<div class="card-header">
					<div class="card-title h5">
						<!-- Back Button -->
						<button class="topleft-back" type="button" data-get="/Member/List" uk-tooltip="title: Back to Previous Section; pos: top-left;"><i class="fa-solid fa-arrow-left"></i></button> &nbsp;
						<!-- Page Title -->
						Member @Model.Member.Code
					</div>
				</div>

				<div class="card-body my-pagecard-body">
					<input type="hidden" asp-for="Member.Id" />

					<!-- Avatar -->
					<div class="form-group">
						<label class="upload">
							<img src="@(!string.IsNullOrEmpty(Model.Person.Avatar) ? "/images/user/member/" + Model.Person.Avatar : "../defaultProfile.png")">

							<label asp-for="Person.Avatar" class="form-label" style="display:none;"></label>
							<div class="upload-insidelayout columns col-gapless">
								<div class="column col-2">
									<button class="capture-photo-btn " type="button" uk-tooltip="title: Drop or select photo; pos: top-right">
										<i class="fa-solid fa-camera-retro"></i>
									</button>
								</div>

								<div class="column col-10">
									<div class="upload-inputbox">
										<label for="file-upload" class="file-upload-label">
											<i class="fa-solid fa-cloud-arrow-up"></i> Attach avatar by dropping it here, or <span class="select-text">selecting one</span>.
										</label>
										<input asp-for="Person.Upload_image" id="file-upload" type="file" accept="image/jpeg,image/png,image/jpg" class="file-input">
									</div>
								</div>
							</div>

						</label>
						<span asp-validation-for="Person.Upload_image" class="form-input-hint error-message"></span>
					</div>

					<div class="uk-grid">
						<div class="uk-width-1-3">
							<!-- Member Id -->
							<div class="form-group">
								<label asp-for="Member.Id" class="form-label">Member Id:</label>
								<div style="padding-bottom:0.5rem;">@Model.Member.Code</div>
							</div>
						</div>

						<div class="uk-width-1-3">
							<!-- Register_date -->
							<div class="form-group">
								<label asp-for="Person.Registration_date" class="form-label">Register Date:</label>
								<div>@Helpers.FormatDate(Model.Person.Registration_date)</div>
							</div>
						</div>

						<div class="uk-width-1-3">
							<!-- Member Level -->
							<div class="form-group">
								<label asp-for="Member.Level" class="form-label">Member Level:</label>
								<div>@Model.Member.Level</div>
							</div>
						</div>

						<div class="uk-width-1-3">
							<!-- Member Referral Id -->
							<div class="form-group">
								<label asp-for="Member.Referral_id" class="form-label">Referral Id:</label>
								<div style="padding-bottom:0.5rem;">@Model.Member.Referral_id</div>
							</div>
						</div>

						<div class="uk-width-1-3">
							<!-- Register_date -->
							<div class="form-group">
								<label asp-for="Member.Referral_person_id" class="form-label">Referral Person Id:</label>
								<div>@(Model.Member.Referral_person_id ?? "None")</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- right-side -->
			<div class="formformat-right column col-6 col-sm-12 ">

				<!-- Name -->
				<div class="form-group">
					<label asp-for="Person.Name" class="form-label">Name:</label>
					<input asp-for="Person.Name" type="text" class="form-input name" data-trim />
					<span asp-validation-for="Person.Name" class="form-input-hint error-message"></span>
				</div>

				<!-- Gender -->
				<div class="form-group">
					<label asp-for="Person.Gender" class="form-label">Gender:</label>
					<div class="input-group">
						<label class="form-radio">
							<input type="radio" asp-for="Person.Gender" id="Person_Gender_Male" name="Person.Gender" value="M">
							<i class="form-icon"></i>Male
						</label>
						<label class="form-radio">
							<input type="radio" asp-for="Person.Gender" id="Person_Gender_Female" name="Person.Gender" value="F">
							<i class="form-icon"></i>Female
						</label>
					</div>
					<span asp-validation-for="Person.Gender" class="form-input-hint error-message"></span>
				</div>

				<!-- Email -->
				<div class="form-group">
					<label asp-for="Person.Email" class="form-label">Email:</label>
					<input asp-for="Person.Email" type="email" class="form-input email-d" data-trim />
					<span asp-validation-for="Person.Email" class="form-input-hint error-message"></span>
				</div>

				<!-- Tel_no -->
				<div class="form-group">
					<label asp-for="Person.Tel_no" class="form-label">Tel_no:</label>
					<input asp-for="Person.Tel_no" type="tel" class="form-input tel_no" data-trim />
					<span asp-validation-for="Person.Tel_no" class="form-input-hint error-message"></span>
				</div>

				<!-- Password -->
				<div class="form-group">
					<label asp-for="Person.Password" class="form-label">Password:</label>
					<input asp-for="Person.Password" class="form-input pass-d" type="password" data-trim />
					<span asp-validation-for="Person.Password" class="form-input-hint error-message"></span>
				</div>

				<!-- Buttons -->
				<div class="text-right" style="padding-top:16px;">
					<button type="reset" class="btn btn-secondary">Reset</button>
					<button id="submitButton" type="submit" class="btn btn-primary">Save</button>
				</div>
			</div>
		</div>
	</div>
</form>

@section foot {
	<script>
		var bar = document.getElementById('js-progressbar');
		let originalEmail = '@(Html.Raw(Model.Person.Email))';

		$(document).ready(function () {
			// Form submit
			$('form').submit(function (event) {
				event.preventDefault();

				// Trigger blur event to check and display
				$('.name, .email-d, .pass-d, .tel_no').trigger('blur');
				$('input[name="Person.Gender"]').trigger('change');


				// Add a short delay to make sure the blur event is processed
				setTimeout(() => {
					// Check for form errors before submission
					if (!nameErr && !emailErr && !telErr && !genderErr && !passErr) {

						// Submit the form when all field is valid
						HTMLFormElement.prototype.submit.call(this);
					}
					else {
					   console.log("NameErr: " + nameErr);
					   console.log("EmailErr: " + emailErr);
					   console.log("passErr: " + passErr);
					   console.log("telErr: " + telErr);
					   console.log("genderErr: " + genderErr);
					}
				}, 100); // 100ms delay to ensure blur event has time to process
			});
		});

		UIkit.upload('.js-upload', {

			url: '',
			multiple: true,

			beforeSend: function () {
				console.log('beforeSend', arguments);
			},
			beforeAll: function () {
				console.log('beforeAll', arguments);
			},
			load: function () {
				console.log('load', arguments);
			},
			error: function () {
				console.log('error', arguments);
			},
			complete: function () {
				console.log('complete', arguments);
			},

			loadStart: function (e) {
				console.log('loadStart', arguments);

				bar.removeAttribute('hidden');
				bar.max = e.total;
				bar.value = e.loaded;
			},

			progress: function (e) {
				console.log('progress', arguments);

				bar.max = e.total;
				bar.value = e.loaded;
			},

			loadEnd: function (e) {
				console.log('loadEnd', arguments);

				bar.max = e.total;
				bar.value = e.loaded;
			},

			completeAll: function () {
				console.log('completeAll', arguments);

				setTimeout(function () {
					bar.setAttribute('hidden', 'hidden');
				}, 1000);

				alert('Upload Completed');
			}

		});
	</script>
}