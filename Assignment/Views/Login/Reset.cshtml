@model ResetPasswordVM

@{
	Layout = "_LoginLayout";
	ViewBag.Title = "Reset Password";
}
@* <script src="/js/general/signlogin.js"></script> *@

<div class="container">
	<section id="formHolder">
		<div class="row">
			<!-- Brand Box -->
			<div class="brand">
				<a href="/Home/Home" class="logo">
					<img src="/images/logo.png" height="64px" width="64px" alt="logo" style=" border-radius: 100%; padding: .5em;">
				</a>
				<div class="heading">
					<h2>OwO Meow Beauty</h2>
					<p>Your Right Choice></p>
				</div>
			</div>
			<!-- Form Box -->
			<div class="col-sm-6 form">
				<div class="login form-peice ">
					<form method="post" id="reset-form">
						<div class="form-group">
							<label asp-for="New_password">Passowrd:</label>
							<input asp-for="New_password" type="password" class="pass" id="regPass" autofocus data-trim />
							<span asp-validation-for="New_password" class="error"></span>
						</div>

						<div class="form-group">
							<label asp-for="Password">Confirm Passowrd:</label>
							<input asp-for="Password" type="password" class="passConfirm" data-trim />
							<span asp-validation-for="Password" class="error"></span>
						</div>

						<div class="CTA">
							<input type="reset" value="Clear">
							<input type="submit" value="Reset Password">
						</div>
					</form>
				</div>
			</div>
		</div>
	</section>
</div>
