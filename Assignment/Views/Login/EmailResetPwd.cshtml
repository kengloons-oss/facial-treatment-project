@model EmailResetPwdVM
@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Send Email";
}

<div class="container">
    <section id="formHolder">
        <div class="row">
            <!-- Brand Box -->
            <div class="brand">
                <a href="../member/home.php" class="logo">
                    <img src="/images/logo.png" height="64px" width="64px" alt="logo"
                         style=" border-radius: 100%; padding: .5em;">
                </a>
                <div class="heading">
                    <h2>OwO Meow Beauty</h2>
                    <p>Your Right Choice></p>
                </div>
            </div>
            <!-- Form Box -->
            <div class="col-sm-6 form">
                <div class="login form-peice ">
                    <form method="post" class="sendEmail-form">
                        <div class="form-group">
                            <label asp-for="Email">Email:</label><br />
                            <div class="input-container" style="width:100%;">
                                <input asp-for="Email" type="text" class="email" style="margin:0;" autofocus data-trim />
                                <input class="sendbtn" type="submit" value="Send" style="margin:0;">
                                <span asp-validation-for="Email" class="error"></span>
                            </div>
                        </div>

                        <div class="CTA">
                            <a href="/Login/Login" class="btn">Back to Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>
