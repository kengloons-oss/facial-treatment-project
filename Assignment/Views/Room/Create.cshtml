@using Assignment.Models
@model RoomVM

@{
	Layout = "_StaffLayout";
	ViewBag.Title = "Room | Create";

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Room", "/Room/List"),
		new KeyValuePair<string, string>("Create", null)
	};
}
<form id="dynamicForm" method="post" class="">
	<div class="container">
		<div class="columns">
			<!-- left-side -->
			<div class="formformat column col-6 col-sm-12 card my-single-card">

				<div class="card-header">
					<div class="card-title h5">
						<!-- Back Button -->
						<button class="topleft-back" type="button" data-get="/Room/List" uk-tooltip="title: Back to Previous Section; pos: top-left;"><i class="fa-solid fa-arrow-left"></i></button> &nbsp;
						<!-- Page Title -->
						Create Room
					</div>
				</div>

				<div class="card-body my-pagecard-body">
					<!-- Room Name -->
					<div class="form-group">
						<label asp-for="Name" class="form-label">Room Name: </label>
						<input asp-for="Name" class="form-input name" autofocus />
						<span asp-validation-for="Name" class="form-input-hint error-message"></span>
					</div>

					<!-- Buttons -->
					<div class="form-group text-right">
						<br /><br />
						<button type="reset" class="btn btn-secondary">Reset</button>
						<button id="submitButton" type="submit" class="btn btn-primary">Create</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

