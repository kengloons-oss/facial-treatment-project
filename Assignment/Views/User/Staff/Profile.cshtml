@model StaffPersonVM

@{
	Layout = "_StaffLayout";
	ViewBag.Title = "Profile";

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Your Profile", null)
	};
}

<form id="dynamicForm" method="post" action="/User/Profile" enctype="multipart/form-data" class="">
	<div class="container card my-pagecard"><!-- container card (got border line) -->
		<div class="columns">
			<!-- left-side -->
			<div class="formformat column col-6 col-sm-12" >
				<div asp-validation-summary="ModelOnly"></div>

				<div class="card-header"> 
					<div class="card-title h5"> 
						<!-- Back Button -->
						<button class="topleft-back" type="button" onclick="back()" uk-tooltip="title: Back to Previous Section; pos: top-left;"><i class="fa-solid fa-arrow-left"></i></button> &nbsp;
						<!-- Page Title -->
						Your Profile
					</div> 
				</div> 

				<div class="card-body my-pagecard-body">
					<input type="hidden" asp-for="Staff.Id" />
					<input type="hidden" asp-for="Staff.Role" />
					<input type="hidden" asp-for="Staff.Salary" value ="@Model.Staff.Salary" />
					<input type="hidden" asp-for="Person.CapturePhoto" value="@ViewBag.CapturePhoto" />

					<!-- Avatar -->
					<div class="form-group">
						<label class="upload">
							<img src="@(!string.IsNullOrEmpty(Model.Person.Avatar) ? Model.Person.Avatar : "/images/user/defaultProfile.png")">

							<label asp-for="Person.Avatar" class="form-label" style="display:none;"></label>
							<div class="upload-insidelayout columns col-gapless">
								<div class="column col-2">
									<button class="capture-photo-btn " type="button" uk-tooltip="title: Capture Image by Camera; pos: top-right">
										<i class="fa-solid fa-camera-retro"></i >
										</button>
								</div>
								<div class="column col-10">
									<div class="upload-inputbox">
										<label for="file-upload" class="file-upload-label">
											<i class="fa-solid fa-cloud-arrow-up"></i> Attach avatar by dropping it here, or <span class="select-text">selecting one</span>.
										</label>
										<input asp-for="Person.Upload_image" id="file-upload" type="file" accept="image/jpeg,image/png,image/jpg" class="file-input">
									</div>
								</div>
							</div>

						</label>
						<span asp-validation-for="Person.Upload_image" class="form-input-hint error-message"></span>
					</div>

					<div class="uk-grid">
						<div class="uk-width-1-3">
							<!-- Staff Id -->
							<div class="form-group ">
								<label asp-for="Staff.Id" class="form-label">Staff Id:</label>
								<div style="padding-bottom:0.5rem;">@Model.Staff.Code</div>
							</div>
						</div>
						<div class="uk-width-1-3">
							<!-- Register_date -->
							<div class="form-group ">
								<label asp-for="Person.Registration_date" class="form-label">Register Date:</label>
								<div>@Helpers.FormatDate(Model.Person.Registration_date)</div>
							</div>
						</div>
						<!-- Gender -->
						<div class="form-group">
							<label asp-for="Person.Gender" class="form-label" style="padding-bottom:0;">Gender:</label>
							<div class="input-group">
								<label class="form-radio" style="margin:0;">
									<input type="radio" asp-for="Person.Gender" id="Person_Gender_Male" name="Person.Gender" value="M">
									<i class="form-icon"></i>Male
								</label>
								<label class="form-radio" style="margin: 0px 0px 0px 10px;">
									<input type="radio" asp-for="Person.Gender" id="Person_Gender_Female" name="Person.Gender" value="F" >
									<i class="form-icon"></i>Female
								</label>
							</div>
							<span asp-validation-for="Person.Gender" class="form-input-hint error-message"></span>
						</div>
					</div>

					<!-- Name -->
					<div class="form-group">
						<label asp-for="Person.Name" class="form-label">Name:</label>
						<input asp-for="Person.Name" type="text" class="form-input name" data-trim />
						<span asp-validation-for="Person.Name" class="form-input-hint error-message"></span>
					</div>
				</div><!-- end card-body -->
			</div><!-- end left-side -->
			

			<!-- right-side -->
			<div class="formformat-right column col-6 col-sm-12 ">
				<div class="uk-grid">
					<div class="uk-width-1-3">
						<!-- Tel_no -->
						<div class="form-group">
							<label asp-for="Person.Tel_no" class="form-label">Tel_no:</label>
							<input asp-for="Person.Tel_no" type="tel" class="form-input tel_no" data-trim />
							<span asp-validation-for="Person.Tel_no" class="form-input-hint error-message"></span>
						</div>
					</div>

					<div class="uk-width-expand" style="padding-left: 20px;">
						<!-- Address -->
						<div class="form-group">
							<label asp-for="Staff.Address" class="form-label">Address:</label>
							<textarea asp-for="Staff.Address" class="form-input address" data-trim></textarea>
							<span asp-validation-for="Staff.Address" class="form-input-hint error-message"></span>
						</div>
					</div>

				</div>
				
				<!-- Email -->
				<div class="form-group">
					<label asp-for="Person.Email" class="form-label">Email:</label>
					<input asp-for="Person.Email" type="email" class="form-input email" data-trim />
					<span asp-validation-for="Person.Email" class="form-input-hint error-message"></span>
					<button type="button" class="btn btn-primary" id="verify-email-btn">Verify</button>
				</div>

				<!-- Current Password -->
				<div class="form-group">
					<label asp-for="Person.Current_password" class="form-label">Current Password:</label>
					<input asp-for="Person.Current_password" class="form-input currentPass" type="password" data-trim />
					<span asp-validation-for="Person.Current_password" class="form-input-hint error-message"></span>
				</div>

				<!-- New Password -->
				<div class="form-group">
					<label asp-for="Person.New_password" class="form-label">New Password:</label>
					<input asp-for="Person.New_password" class="form-input newPass" type="password" disabled data-trim />
					<span asp-validation-for="Person.New_password" class="form-input-hint error-message"></span>
				</div>

				<!-- Confirm Password -->
				<div class="form-group">
					<label asp-for="Person.Password" class="form-label">Confirm Password:</label>
					<input asp-for="Person.Password" class="form-input confirmPass" type="password" disabled data-trim />
					<span asp-validation-for="Person.Password" class="form-input-hint error-message"></span>
				</div>

				<!-- Buttons -->
				<div class="text-right" style="padding-top:16px;">
					<button type="reset" class="btn btn-secondary">Reset</button>
					<button id="submitButton" type="submit" class="btn btn-primary">Save</button>
				</div>
			</div><!-- end right-side -->

		</div><!-- end columns -->
	</div><!-- end container card -->
</form>

<script>

	var bar = document.getElementById('js-progressbar');
	let originalEmail = '@(Html.Raw(Model.Person.Email))';

	// Click for capture photo
	$(document).on('click', '.capture-photo-btn', function (e) {
		e.preventDefault();

		Swal.fire({
			title: "Leave Profile Page?",
			text: "Navigating to the photo capture page may discard any changes to your profile. Make sure to save your updates if necessary before proceeding.",
			icon: "warning", // Options: 'success', 'error', 'warning', 'info', 'question'
			showDenyButton: false,
			showCancelButton: true,
			confirmButtonText: "Proceed",
			cancelButtonText: "Stay"
		}).then((result) => {
			if (result.isConfirmed) {
				window.location.href = "/User/CapturePhoto";
			}
		});

	});

	$(document).ready(function () {

		$('#verify-email-btn').hide();

		// Handle verify button click
		$(document).on('click', '#verify-email-btn', function (e) {
			e.preventDefault();

			// Get the email value from the input
			const email = $('.email').val();

			// Show a confirmation dialog
			Swal.fire({
				title: "Verify Email",
				text: `Navigating to the verify email page may discard any changes to your profile. Make sure to save your updates if necessary before proceeding.`,
				icon: 'warning',
				showDenyButton: false,
				showCancelButton: true,
				confirmButtonText: "Proceed",
				cancelButtonText: "Stay"
			}).then((result) => {
				if (result.isConfirmed) {
					// Show loading spinner
					loadingAlert();

					// Send a GET request to /User/GenAndSendOTP with the email as a query parameter
					const url = `/User/GenAndSendOTP?email=${encodeURIComponent(email)}`;
					window.location.href = url; // Redirect to the URL
				}
			});
		});

		$('#file-upload').on('change', function () {
			if (this.files && this.files.length > 0) {
				// Set the hidden input for CapturePhoto to null if a file is uploaded
				$('input[name="Person.CapturePhoto"]').val(null);
			}
		});

		$('input').on('blur input', function () {
			// Email
			if ($(this).hasClass('email')) {
				const inputElement = $(this);
				const email = inputElement.val();

				// Hide the verify button initially
				$('#verify-email-btn').hide();

				// Validate the email format
				const validationError = validateEmail(email);

				if (validationError) {
					showError(inputElement, validationError);
					emailErr = true;
					return;
				}

				// Check if the email is different from the original
				if (email && email !== originalEmail) {
					checkEmailExist(email, function (exists) {
						if (exists) {
							showError(inputElement, 'Email already exists');
							emailErr = true;
						} else {
							clearError(inputElement);
							emailErr = false;

							// Show the verify button after successful validation
							$('#verify-email-btn').show();
						}
					});
				} else {
					// Clear any error for unchanged emails
					clearError(inputElement);
					emailErr = false;
				}
			}
		});

		// Form submit
		$('form').submit(function (event) {
			event.preventDefault();

			// Trigger blur event to check and display
			$('.name, .email, .currentPass, .tel_no, .address').trigger('blur');
			$('input[name="Person.Gender"]').trigger('change');


			// Add a short delay to make sure the blur event is processed
			setTimeout(() => {
				// Check for form errors before submission
				if (!nameErr && !emailErr && !currentPassErr && !passErr && !confirmPassErr && !telErr && !genderErr && !addressErr) {

					// Submit the form when all field is valid
					HTMLFormElement.prototype.submit.call(this);
				}
				else {
				   console.log("NameErr: " + nameErr);
				   console.log("EmailErr: " + emailErr);
				   console.log("currentPassErr: " + currentPassErr);
				   console.log("passErr: " + passErr);
				   console.log("confirmPassErr: " + confirmPassErr);
				   console.log("telErr: " + telErr);
				   console.log("genderErr: " + genderErr);
				   console.log("addressErr: " + addressErr);
				}
			}, 100); // 100ms delay to ensure blur event has time to process
		});

	});

</script>
