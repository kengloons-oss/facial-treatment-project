@model AppointmentVM

@{
	Layout = "_StaffLayout";
	ViewBag.Title = "Appointment | Create (Others)";

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Appointment", "/Appointment/FullCalendar"),
		new KeyValuePair<string, string>("Create (Others)", null)
	};

	string currentDate = DateTime.Now.ToString("yyyy-MM-dd");
}

<form id="dynamicForm" method="post">
	<div class="container">
		<div class="columns">
			<!-- left-side -->
			<div class="formformat column col-6 col-sm-12 card my-single-card">
				<div class="card-header">
					<div class="card-title h5">
						<!-- Back Button -->
						<button class="topleft-back" type="button" data-get="/Appointment/FullCalendar" uk-tooltip="title: Back to Previous Section; pos: top-left;"><i class="fa-solid fa-arrow-left"></i></button> &nbsp;
						<!-- Page Title -->
						Create Other Appointment
					</div>
				</div>

				<div class="card-body my-pagecard-body">
					<input type="hidden" name="AppointmentDate" value="@currentDate" />

					<!-- Appointment Type -->
					<div class="form-group">
						<label asp-for="Type" class="form-label">Type: </label>
						<select asp-for="Type" name="Type" class="form-input select2 type" id="AppointmentType">
							<option value="1">Training</option>
							<option value="3">Holiday</option>
						</select>
						<span asp-validation-for="Type" class="form-input-hint error-message"></span>
					</div>

					<!-- Info message -->
					<div id="holidayInfo" class="alert alert-info" style="display: none; margin-bottom:10px;">
						<span class="text-error text-small text-break">* ALL appointments(exepts holidays) within the selected time will all be cancelled *</span>
					</div>

					<!-- Title -->
					<div class="form-group">
						<label asp-for="Title" class="form-label">Title: </label>
						<input asp-for="Title" class="form-input title" />
						<span asp-validation-for="Title" class="form-input-hint error-message"></span>
					</div>

					<!-- Holiday All-day Checkbox -->
					<div class="form-group" id="AllDayCheckboxGroup" style="display: none;">
						<label class="form-label"></label>
						<input type="checkbox" id="AllDayCheckbox" name="All_day" value="true" /> All-day Appointment
						<span asp-validation-for="All_day" class="form-input-hint error-message"></span>

						<!-- Info message -->
						<div id="allDayInfo" class="alert alert-info">
							<span class="text-error text-small text-break">* The time will be ignore for all day appointment *</span>
						</div>
					</div>

					<!-- Start time -->
					<div class="form-group">
						<label asp-for="Start_datetime" class="form-label">Start DateTime: </label>
						<div class="uk-inline" style="width:100%;">
							<a class="uk-form-icon uk-form-icon-flip" href="#" uk-icon="icon: calendar"></a>
							<input name="Start_datetime" type="text" class="form-input uk-input" id="Start_datetime" placeholder="Select Start DateTime..." aria-label="Clickable icon" />
						</div>
						<span asp-validation-for="Start_datetime" class="form-input-hint error-message"></span>
					</div>

					<!-- End time -->
					<div class="form-group">
						<label asp-for="End_datetime" class="form-label">End DateTime: </label>
						<div class="uk-inline" style="width:100%;">
							<a class="uk-form-icon uk-form-icon-flip" href="#" uk-icon="icon: calendar"></a>
							<input asp-for="End_datetime" class="form-input uk-input" id="End_datetime" placeholder="Select End DateTime..." aria-label="Clickable icon" />
						</div>
						<span asp-validation-for="End_datetime" class="form-input-hint error-message"></span>
					</div>

					<!-- Staff (if type == training) -->
					<div class="form-group" id="StaffSelection" style="display: none;">
						<label asp-for="StaffList" class="form-label">Staff(s): </label>
						<div class="input-group">
							<select id="StaffDropdown" name="StaffList" class="form-input select2 staffList" multiple>
								<option value="">Select Staff (Only show available staff)</option>
							</select>

							<span asp-validation-for="StaffList" class="form-input-hint error-message"></span>
						</div>
						<!-- Info message -->
						<div id="TrainingInfo" class="alert alert-info">
							<span class="text-error text-small text-break">* only staff(s) available between the start and end time interval will be displayed *</span>
						</div>
					</div>

					<!-- Buttons -->
					<div class="text-right" style="padding-top:16px;">
						<button type="reset" class="btn btn-secondary">Reset</button>
						<button id="submitButton" type="submit" class="btn btn-primary">Create</button>
					</div>
				</div>
			</div> <!-- end left-side -->
			<!-- right-side -->
			<div class="column col-6 col-sm-12 uk-flex uk-flex-middle uk-flex-center">
			</div><!-- end right-side -->
		</div>
	</div>
</form>

@section foot {
	<script>
		$(document).ready(function () {
			// Initialize select2
			$('.select2').select2({
				allowClear: false,
				width: '100%' // Ensure full width
			});

			// Initialize Select2 on the dropdown
			$('#StaffDropdown').select2({
				placeholder: "Select staff",
				maximumSelectionLength: 5
			});

			// Function to calculate the next 15-minute time slot after the current time
			function getNextAvailableTime() {
				const now = new Date();

				// If the current time is before 10 AM, start from 10 AM
				if (now.getHours() < 10) {
					now.setHours(10, 0, 0, 0);
				} else if (now.getHours() >= 22) {
					// If it's after 10 PM, set the time to 10 PM
					now.setHours(22, 0, 0, 0);
				} else {
					// Round the time to the next 15-minute interval
					const minutes = Math.ceil(now.getMinutes() / 15) * 15;
					now.setMinutes(minutes);
					now.setSeconds(0);
					now.setMilliseconds(0);
				}

				return now;
			}

			// Format the date to 'YYYY-MM-DD HH:mm' format
			function formatDate(date) {
				const year = date.getFullYear();
				const month = (date.getMonth() + 1).toString().padStart(2, '0');
				const day = date.getDate().toString().padStart(2, '0');
				const hours = date.getHours().toString().padStart(2, '0');
				const minutes = date.getMinutes().toString().padStart(2, '0');
				return `${year}-${month}-${day} ${hours}:${minutes}`;
			}

			// Get the next available time slot
			const nextAvailableTime = getNextAvailableTime();

			// Format the next available time slot to 'YYYY-MM-DD HH:mm' format
			const nextAvailableTimeFormatted = formatDate(nextAvailableTime);

			// Initialize the flatpickr for Start and End datetime pickers (default state with time)
			const startPicker = flatpickr("#Start_datetime", {
				minDate: new Date().toISOString().split('T')[0],  // Set min date to current date
				minTime: "10:00", // Set minimum time to 10 AM
				maxTime: "22:00", // Set maximum time to 10 PM
				enableTime: true,
				noCalendar: false,
				dateFormat: "Y-m-d H:i",  // Format for the date and time
				time_24hr: false,
				minuteIncrement: 15,  // Allow time slots every 15 minutes
				defaultHour: nextAvailableTime.getHours(),  // Default hour to the next available slot
				defaultMinute: nextAvailableTime.getMinutes(),  // Default minute to the next available slot
				disableMobile: true,  // Disable mobile version for better control (optional)
				allowInput: false
			});

			const endPicker = flatpickr("#End_datetime", {
				minDate: new Date().toISOString().split('T')[0],  // Set min date to current date
				minTime: "10:00", // Set minimum time to 10 AM
				maxTime: "22:00", // Set maximum time to 10 PM
				enableTime: true,
				noCalendar: false,
				dateFormat: "Y-m-d H:i",  // Format for the date and time
				time_24hr: false,
				minuteIncrement: 15,  // Allow time slots every 15 minutes
				defaultHour: nextAvailableTime.getHours(),  // Default hour to the next available slot
				defaultMinute: nextAvailableTime.getMinutes(),  // Default minute to the next available slot
				disableMobile: true,  // Disable mobile version for better control (optional)
				allowInput: false
			});


			// Toggle visibility of staff selection and holiday info based on appointment type
			$('#AppointmentType').on('change', function () {
				const selectedType = $(this).val();
				if (selectedType === '1') {
					$('#StaffSelection').show();
					$('#holidayInfo').hide(); // Hide holiday info
					$('#AllDayCheckboxGroup').hide();
					loadAvailableStaff();
				} else if (selectedType === '3') {
					$('#StaffSelection').hide();
					$('#holidayInfo').show(); // Show holiday info
					$('#AllDayCheckboxGroup').show();
				}
			});

			// Trigger the change event to set initial visibility
			$('#AppointmentType').trigger('change');

			// Load available staff based on selected datetime range
			function loadAvailableStaff() {
				const startTime = $('#Start_datetime').val();
				const endTime = $('#End_datetime').val();

				if (startTime && endTime) {
					$('#StaffDropdown').prop('disabled', true).html('<option>Loading...</option>');

					$.ajax({
						url: '/Appointment/GetAvailableStaff',
						method: 'GET',
						data: {
							startTime: startTime,
							endTime: endTime
						},
						success: function (data) {
							$('#StaffDropdown').empty();

							if (data.length > 0) {
								data.forEach(function (staff) {
									$('#StaffDropdown').append(`<option value="${staff.id}">${staff.name}</option>`);
									clearError($('#StaffDropdown'));
								});

							} else {
								showError($('#StaffDropdown'), 'No staff available for this time');
							}

							$('#StaffDropdown').select2('destroy').select2();
							$('#StaffDropdown').prop('disabled', false).trigger('change');
						},
						error: function (xhr, status, error) {
							console.error(`Error: ${status}, ${error}`);
							alert('Error loading available staff. Please try again.');
							$('#StaffDropdown').prop('disabled', false);
						}
					});
				}
				// else {
				// 	showError($('#StaffDropdown'), '* only staff(s) available between the start and end time interval will be displayed *');
				// }
			}


			$('#Start_datetime').on('change', function () {
				const selectedStartDateTime = $('#Start_datetime').val();
				const inputElement = $(this);

				if (selectedStartDateTime) {
					endPicker.set('minDate', selectedStartDateTime);
				}
			});

			$('#End_datetime').on('change', function () {
				const selectedStartDateTime = $('.End_datetime').val();
				if (selectedStartDateTime) {
					startPicker.set('maxDate', selectedStartDateTime);
				}
			});

			$('#Start_datetime, #End_datetime').on('change', function () {
				var start = $('#Start_datetime').val();
				var end = $('#End_datetime').val();
				var type = $('.type').val();

				if (start && end) {
					if ((type == 1 && (end > start) || (type == 3 && (end >= start)))) {
						loadAvailableStaff();

						clearError($('#Start_datetime'));
						clearError($('#End_datetime'));
						startDateTimeErr = false;
						endDateTimeErr = false;
					} else {
						showError($('#End_datetime'), 'End DateTime cannot be same or earlier than Start DateTime');
						endDateTimeErr = true;
					}
				} else if (start) {
					showError($('#End_datetime'), 'End DateTime is required');
					endDateTimeErr = true;
				} else if (end) {
					showError($('#Start_datetime'), 'Start DateTime is required');
					startDateTimeErr = true;

				} else {
					showError($('#Start_datetime'), 'Start DateTime is required');
					startDateTimeErr = true;

					showError($('#End_datetime'), 'End DateTime is required');
					endDateTimeErr = true;
				}

				if(startDateTimeErr || endDateTimeErr){
					// Clear staff list and reset the dropdown
					$('#StaffDropdown').empty();
					$('#StaffDropdown').val('');  // Clear selected value
					$('#StaffDropdown').trigger('change');  // Notify select2 to update
				}
			});


			// Handle check and uncheck All-day
			$('#AllDayCheckbox').on('change', function () {
				const isChecked = $(this).is(':checked');

				// Get today's date in the local timezone
				const today = new Date();
				const localDate = today.getFullYear() +
					'-' + String(today.getMonth() + 1).padStart(2, '0') +
					'-' + String(today.getDate()).padStart(2, '0');

				if (isChecked) {
					console.log("All-day selected: Hiding time selection.");
					startPicker.set({
						enableTime: false,       // Disable time selection
						dateFormat: "Y-m-d",     // Date-only format
						minDate: localDate,      // Set minimum date to today
					});
					endPicker.set({
						enableTime: false,
						dateFormat: "Y-m-d",
						minDate: localDate,
					});
				} else {
					console.log("Time enabled: Showing datetime selection.");
					startPicker.set({
						enableTime: true,        // Enable time selection
						dateFormat: "Y-m-d H:i", // Datetime format
						minDate: localDate,      // Set minimum date to today
						minTime: "10:00",        // Earliest allowed time
					});
					endPicker.set({
						enableTime: true,
						dateFormat: "Y-m-d H:i",
						minDate: localDate,
						minTime: "10:00",
					});
				}

				// Ensure valid selected dates are updated
				if (!startPicker.selectedDates[0]) {
					startPicker.setDate(localDate, true);
				}
				if (!endPicker.selectedDates[0]) {
					endPicker.setDate(localDate, true);
				}
			});


			// Form submit
			$('form').submit(function (event) {
				event.preventDefault();

				// Trigger blur event to check and display
				$('.title, .type, .staffList').trigger('blur');
				$('#StaffDropdown').trigger('change');

				// Add a short delay to make sure the blur event is processed
				setTimeout(() => {
					// Check for form errors before submission
					if (!titleErr && !typeErr && !startDateTimeErr && !endDateTimeErr && !staffListErr) {
						// Show loading spinner
						loadingAlert();

						// Submit the form when all field is valid
						HTMLFormElement.prototype.submit.call(this);
					}
					else {
						$('#Start_datetime, #End_datetime').trigger('change');
					}
				}, 100); // 100ms delay to ensure blur event has time to process
			});
		});
	</script>
}