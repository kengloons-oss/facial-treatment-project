@model IEnumerable<dynamic>

@{
	Layout = "_StaffLayout";
	ViewBag.Title = "Appointment | Calendar";

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Appointment", "/Appointment/Calendar"),
		new KeyValuePair<string, string>("Full Calendar View", "/Appointment/FullCalendar")
	};
}
<style>
	.status-pending {
		color: #f5a623;
	}
	/* Yellow */
	.status-completed {
		color: #50c878;
	}
	/* Green */
	.status-canceled {
		color: #d9534f;
	}
	/* Red */
	.holiday {
		color: #9e9e9e;
	}
	/* Gray */
</style>

<style>
	.calbar {
		display: flex;
		justify-content: flex-start;
		gap: 10px;
		margin-bottom: 10px;
	}

		.calbar .calbtn {
			border: none;
			border-radius: 5px;
			cursor: pointer;
		}

	.today {
		background-color: #135de6;
		color: white;
		font-size: 16px;
		padding: 5px 30px;
		font-weight: bold;
	}

	.back-to-month {
		font-size: 16px;
		padding: 5px 30px;
		font-weight: bold;
	}

	.prev, .next {
		background-color: #a2b6e0;
		color: white;
		padding: 5px 6px;
	}

	.prev {
		margin: 0 0 0 1rem;
	}

	.next {
		margin: 0 1rem 0 0;
	}

	.navbar--range {
		font-size: 22px;
		font-weight: bold;
	}

	.toastui-calendar-icon {
		margin-top: 8px;
	}

	.toastui-calendar-ic-edit {
		display: none;
	}

	.toastui-calendar-edit-button:hover {
		background-color: #CADCFF;
		font-weight: bold;
	}

	.toastui-calendar-delete-button:hover {
		background-color: #ffcaca;
		font-weight: bold;
	}
</style>

<div class="calbar">
	<button class="btn-sm calbtn today">Today</button>
	<button class="btn-sm calbtn prev">
		<i class="fa-solid fa-angle-left"></i>
	</button>
	<span class="navbar--range"></span>
	<button class="btn-sm calbtn next">
		<i class="fa-solid fa-angle-right"></i>
	</button>
	<button class=" btn btn-sm back-to-month" style="display:none;"><i class="fa-solid fa-calendar-days"></i> Monthly View</button>
	<button data-get="/Appointment/Create" class="btn-sm calbtn today">Create Work Appointment</button>

	@if(Helpers.isManager()){
		<button data-get="/Appointment/CreateOther" class="btn-sm calbtn today">Create Others Appointment</button>
	}
</div>

<div id="calendar" style="height: 550px;"></div>

<script>
	$(document).on('click', '.scan-barcode-btn', function (e) {
		e.preventDefault();

		var id = $(this).data('id');  // Access the ID from the data-id attribute
		var status = $(this).data('status');

		if(status === "Pending"){
			window.location.href = "/Appointment/ScanBarCode/" + id;
		}
		else {
			Swal.fire({
				title: "Action Failed",
				text: 'The appointment already passed or canceled, cannot scan barcode for start.',
				icon: 'error', // You can use 'success', 'error', 'warning', 'info', or 'question'
				showDenyButton: false,
				showCancelButton: false,
				confirmButtonText: "OK"
			});
		}
	});

	// Initialize calendar
	const calendar = new tui.Calendar('#calendar', {
	  defaultView: 'month',
	  isReadOnly: false,
	  useCreationPopup: false,
	  useDetailPopup: true,
	  month: {startDayOfWeek: 1,},
	  calendars: [
		{
		  id: 'training',
		  name: 'Training/Other',
		  backgroundColor: '#007bff', // Blue
		  borderColor: '#007bff',
		},
		{
		  id: 'working',
		  name: 'Working Appointment',
		  backgroundColor: '#50c878', // Green
		  borderColor: '#50c878',
		},
		{
		  id: 'holiday',
		  name: 'Holiday',
		  backgroundColor: '#9e9e9e', // Gray
		  borderColor: '#9e9e9e',
		},
	  ],
		  gridSelection: {
	  enableDblClick: false,
	  enableClick: true,
	}
	});

	const calendarData = @Html.Raw(Json.Serialize(Model));

	// Initialize the calendar with fetched data
	calendar.createEvents(calendarData);

	// Customize the popup with your event data
	calendar.setOptions({
	  template: {
		popupDetailTitle({ title }) {
		  return `<strong>${title}</strong>`;
		},

		// Changed popupDetailBody to return string instead of using raw object directly
		popupDetailBody({ body, raw, calendarId, isAllDay}) {

		  // Adjust the calendarId check to match your actual calendarIds
		  if (calendarId === 'training') {
			// Create a string from raw data for 'training' calendar events
			return `
			  <div><strong>Staff:</strong> ${raw.staff || 'N/A'}</div>
			  <div><strong>Treatment:</strong> ${raw.treatment || 'N/A'}</div>
			  <div><strong>Email:</strong> ${raw.email || 'N/A'}</div>
			  <div><strong>Status:</strong> ${raw.status || 'N/A'}</div>
			`;
		  } else if (calendarId === 'working') {
			// For 'working' calendar, you can return a different format
			return `
			  <div><strong>Staff:</strong> ${raw.staff || 'N/A'}</div>
			  <div><strong>Status:</strong> ${raw.status || 'N/A'}</div>
			  <div><button type="button" class="scan-barcode-btn" data-id="${raw.appointmentId}" data-status="${raw.status || 'N/A'}">Scan BarCode</button></div>
			`;
		  }
		  return ''; // Default case if no matching calendar
		},

		popupEdit() {
		  return 'View Details';
		},
		popupDelete() {
			// Return the button with a data attribute for the event ID
			return 'Cancel';
		},
	  },
	});

	// Detail
	calendar.on('beforeUpdateEvent', (event) => {

	  // Check if the event has the ID property inside event.event
	  if (event.event && event.event.id) {
		const eventId = event.event.id; // Get the event ID
		window.location.href = "/Appointment/Detail/" + eventId;

	  } else {
		console.log('Appointment is not available');
	  }
	});

	//(DELETE)
	calendar.on('beforeDeleteEvent', (event) => {
		const eventId = event.id;
		const eventStatus = event.raw.status;
		const eventMemberId = event.raw.memberId;

		if(eventStatus === "Pending"){

			Swal.fire({
				title: "Cancel Appointment",
				text: 'Are you confirm to cancel this appointment' + 'AP' + eventId.toString().padStart(4, '0') + '?',
				icon: 'warning', // You can use 'success', 'error', 'warning', 'info', or 'question'
				showDenyButton: false,
				showCancelButton: true,
				confirmButtonText: "Yes"
			}).then((result) => {
				if (result.isConfirmed) {
					// Show loading spinner
					loadingAlert();

					const url = '/Appointment/Cancel?id=' + eventId + '&memberId=' + eventMemberId;  // Construct the URL dynamically using the ID
					const f = $('<form>').appendTo(document.body)[0];
					f.method = 'post';
					f.action = url;
					f.submit();
				}
			});

		}
		else {
			Swal.fire({
				title: "Action Failed",
				text: 'The appointment already passed or canceled, cannot scan barcode for start.',
				icon: 'error', // You can use 'success', 'error', 'warning', 'info', or 'question'
				showDenyButton: false,
				showCancelButton: false,
				confirmButtonText: "OK"
			});
		}
	});

	// Register event for date selection in the calendar
	calendar.on('selectDateTime', (info) => {
		const clickedDate = info.start; // Start of the selected date

		calendar.changeView('day');// Navigate to the daily view
			calendar.setOptions({week: {taskView: false,},}); //Show only 'All Day' bar at Day View
		calendar.setDate(clickedDate); // Move to the selected date
		updateBackToMonthButtonVisibility();
	});



	// Update navbar range to display year-month or year-month-day based on the current view
	const updateNavbarRange = (date) => {
	  const year = date.getFullYear();
	  const month = date.getMonth() + 1;
	  const day = date.getDate();

	  // Check if it's the "day" view to display the full date (YYYY-MM-DD)
	  const currentView = calendar.getViewName();

	  if (currentView === 'day') {
		// If in day view, show full date (YYYY-MM-DD)
		document.querySelector('.navbar--range').textContent = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
	  } else {
		// If not in day view (month or week), show only year-month (YYYY-MM)
		document.querySelector('.navbar--range').textContent = `${year}-${String(month).padStart(2, '0')}`;
	  }
	};

	// Function to update the visibility of "Back to Monthly View" button
	const updateBackToMonthButtonVisibility = () => {
	  const currentView = calendar.getViewName(); // Get the current view type
	  const backToMonthBtn = document.querySelector('.back-to-month');

	  if (currentView === 'day') {
		backToMonthBtn.style.display = 'inline-block'; // Show button in day view
	  } else {
		backToMonthBtn.style.display = 'none'; // Hide button in other views
	  }
	};

	// Event listener for "Today" button
	document.querySelector('.today').addEventListener('click', () => {
	  calendar.today();
	  const currentDate = calendar.getDate();
	  updateNavbarRange(currentDate);
	  updateBackToMonthButtonVisibility();
	});

	// Event listener for "Previous" button
	document.querySelector('.prev').addEventListener('click', () => {
	  calendar.prev();
	  const currentDate = calendar.getDate();
	  updateNavbarRange(currentDate);
	  updateBackToMonthButtonVisibility();
	});

	// Event listener for "Next" button
	document.querySelector('.next').addEventListener('click', () => {
	  calendar.next();
	  const currentDate = calendar.getDate();
	  updateNavbarRange(currentDate);
	  updateBackToMonthButtonVisibility();
	});

	// Event listener for "Back to Monthly View" button
	document.querySelector('.back-to-month').addEventListener('click', () => {
	  calendar.changeView('month'); // Switch to the monthly view
	  updateNavbarRange(calendar.getDate()); // Update the navbar after changing to month view
	  updateBackToMonthButtonVisibility(); // Ensure the button is properly set on page load
	});

	// Register event for date selection in the calendar
	calendar.on('selectDateTime', (info) => {
	  const clickedDate = info.start; // Start of the selected date

	  calendar.changeView('day'); // Navigate to the daily view
	  calendar.setDate(clickedDate); // Move to the selected date

	  // Update navbar to show the selected date
	  updateNavbarRange(clickedDate);

	  updateBackToMonthButtonVisibility(); // Ensure visibility of "Back to Monthly View" button
	});

	// Initial range update and visibility check
	updateNavbarRange(calendar.getDate());
	updateBackToMonthButtonVisibility(); // Ensure the button is properly set on page load

</script>
