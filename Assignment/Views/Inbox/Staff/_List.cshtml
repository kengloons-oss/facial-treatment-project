@using Assignment.Models
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Inbox>

@{
	string[] InboxFields = ["Id", "Title", "Target", "Created Date"];
	bool isManager = Helpers.isManager();
}


@Html.Hidden("sort", "", new { form = "f" })
@Html.Hidden("dir", "", new { form = "f" })
@Html.Hidden("page", "", new { form = "f" })

<div class="card-left-tb">
	@Model.Count() of @Model.TotalItemCount record(s) &nbsp;&nbsp;| &nbsp;
	Page @Model.PageNumber of @Model.PageCount
</div>


<table class="admin-table1">

	<thead>
		<tr>
			@if (isManager)
			{
				<th class="table_headers"><input type="checkbox" id="toggle-header-check" /></th>
			}

			@foreach (var f in InboxFields)
			{
				string d = "asc";
				string c = "";
				string sort_icon = "asc";

				if (f == ViewBag.Sort)
				{
					d = ViewBag.Dir == "des" ? "asc" : "des";
					c = ViewBag.Dir;
					sort_icon = d == "asc" ? "fa-sort-up" : "fa-sort-down";
				}

				<th class="table_headers">
					<a data-ajax="true"
					   data-ajax-update="#target"
					   data-ajax-loading="#loader"
					   href="?title=@ViewBag.Title&target=@ViewBag.Target&status=@ViewBag.Status&sort=@f&dir=@d&page_items=@ViewBag.Page_items&page=@Model.PageNumber" class="@c">
						@f<i class='fas @sort_icon'></i>
					</a>
				</th>
			}
			<th class="table_headers">Action</th>
		</tr>
	</thead>

	<tbody>
		@foreach (var s in Model)
		{
			<tr>
				@if (isManager)
				{
					<td>
						@if (s.Status == 1)
						{
							<input type="checkbox" name="ids" form="f" value="@s.Id" />
						}
					</td>
				}

				<td>@s.Code</td>
				<td>@s.Title</td>
				<td>@Helpers._InboxTarget[s.Target.ToString()]</td>
				<td>@s.Created_datetime</td>
				<td>
					<!-- Edit Button -->
					<button class="uk-button uk-button-default uk-button-small pastel-edit-btn" data-get="/Inbox/Detail/@s.Id" uk-tooltip="View / Edit This Details">
						<span uk-icon="pencil" class="uk-icon"></span> <span class="button-text">@(isManager ? "Edit" : "Detail")</span>
					</button>

					@{
						if (isManager)
						{
							if (s.Status == 1)
							{
								<!-- Deactivate Button -->
								<button class="uk-button uk-button-danger uk-button-small pastel-deactivate-btn equal-width-btn deactivate-btn" data-id="@s.Id" uk-tooltip="Deactivate This">
									<span uk-icon="ban" class="uk-icon"></span> <span class="button-text">Deactivate</span>
								</button>
							}
						}
					}


				</td>
			</tr>
		}

		@if (Model.Count() == 0)
		{
			<tr>
				<td colspan="@(isManager ? 6 : 5)">No available announcement record ~</td>
			</tr>
		}
	</tbody>
</table>

<nav class="admin-pager">
	@{
		var options = PagedListRenderOptions.ClassicPlusFirstAndLast;
		options.LinkToFirstPageFormat = "<i class='fas fa-backward-fast'></i>";
		options.LinkToLastPageFormat = "<i class='fas fa-forward-fast'></i>";
		options.LinkToPreviousPageFormat = "<i class='fas fa-chevron-left'></i>";
		options.LinkToNextPageFormat = "<i class='fas fa-chevron-right'></i>";

		var ajaxOptions = new AjaxOptions
			{
				HttpMethod = "get",
				UpdateTargetId = "target",
				LoadingElementId = "#loader",
			};
	}

	@Html.PagedListPager(
			Model,
			p => $"?title={ViewBag.Title}&target={ViewBag.Target}&status={ViewBag.Status}&sort={ViewBag.Sort}&dir={ViewBag.Dir}&page_items={@ViewBag.Page_items}&page={p}",
			PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(options, ajaxOptions)
			)
</nav>

