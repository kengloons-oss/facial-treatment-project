@model InboxVM

@{
	Layout = "_StaffLayout";
	ViewBag.Title = "Announcement | " + Model.Code;

	// breadcrumb data
	ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
	{
		new KeyValuePair<string, string>("Announcement", "/Inbox/List"),
		new KeyValuePair<string, string>("Detail", null)
	};
}

<form id="dynamicForm" method="post" class="">
	<div class="container">
		<div class="columns">
			<!-- left-side -->
			<div class="formformat column col-6 col-sm-12 card my-single-card">

				<div class="card-header">
					<div class="card-title h5">
						<!-- Back Button -->
						<button class="topleft-back" type="button" onclick="back()" uk-tooltip="title: Back to Previous Section; pos: top-left;"><i class="fa-solid fa-arrow-left"></i></button> &nbsp;
						<!-- Page Title -->
						Announcement @Model.Code
					</div>
				</div>

				<div class="card-body my-pagecard-body">

					<div class="uk-grid">
						<div class="uk-width-1-2">
							<!-- Created_time -->
							<div class="form-group ">
								<label asp-for="Created_datetime" class="form-label">Post Date: </label>
								<div style="padding-bottom:0.5rem;">@Helpers.FormatDate(Model.Created_datetime)</div>
							</div>
						</div>

						<!-- Target -->
						<div class="form-group">
							<label asp-for="Target" class="form-label" style="padding-bottom:0;">Target: </label>

							@if (Model.Status == 0)
							{
								<div class="fake-input">@Helpers._InboxTarget[Model.Target.ToString()]</div>
							}
							else
							{
								<div class="input-group">
									<label class="form-radio">
										<input type="radio" asp-for="Target" id="target_member" name="Target" value="1">
										<i class="form-icon"></i> Member
									</label>
									<label class="form-radio">
										<input type="radio" asp-for="Target" id="target_staff" name="Target" value="2">
										<i class="form-icon"></i> Staff
									</label>
									<label class="form-radio">
										<input type="radio" asp-for="Target" id="target_both" name="Target" value="3">
										<i class="form-icon"></i> Both
									</label>
								</div>
								<span asp-validation-for="Target" class="form-input-hint error-message"></span>
							}

						</div>
					</div>

					<!-- Title -->
					<div class="form-group">
						<label asp-for="Title" class="form-label">Title: </label>
						@if (Model.Status == 0)
						{
							<div class="fake-input">@Model.Title</div>
						}
						else
						{
							<input asp-for="Title" class="form-input title" autofocus />
							<span asp-validation-for="Title" class="form-input-hint error-message"></span>
						}

					</div>

					<!-- Message -->
					<div class="form-group">
						<label asp-for="Message" class="form-label">Message:</label>
						@if (Model.Status == 0)
						{
							<div class="fake-input">@Model.Message</div>
						}
						else
						{
							<textarea asp-for="Message" class="form-input message" rows="3" data-trim></textarea>
							<span asp-validation-for="Message" class="form-input-hint error-message"></span>
						}

					</div>


					@if (Model.Status == 1){
						<!-- Buttons -->
						<div class="form-group text-right">
							<br /><br />
							<button type="reset" class="btn btn-secondary">Reset</button>
							<button id="submitButton" type="submit" class="btn btn-primary">Save</button>
						</div>
					}
					
				</div><!-- end card-body -->
			</div><!-- end left-side -->
		</div>
	</div>
</form>

