			<!-- Order -->
			<a href="/Order/Staff/List" class="group">Order</a>

			<!-- Reply Customer -->
			<a href="https://dashboard.tawk.to/#/dashboard/66e59bce50c10f7a00a9f8ac" class="group" target="_blank">Reply Customer</a>

			<!-- Resources -->
			<div class="group">
				<div class="group-header" onclick="toggleGroup(this)">
