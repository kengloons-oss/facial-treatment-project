					<a href="/Member/List">Member</a>
				</div>
			</div>

			<!-- Business Operations -->
			<div class="group">
				<div class="group-header" onclick="toggleGroup(this)">
					Business Operations
					<i class="fa-solid fa-angle-down toggle-icon"></i>
				</div>
				<div class="group-content">
					<a href="/Inbox/List">Announcement</a>
					<a href="/Membership/List">Membership</a>
					<a href="/TopUpReward/RewardList">Top-Up Rewards</a>
					<a href="/ReferralReward/ReferralRewardList">Referral Rewards</a>
				</div>
			</div>

			<!-- Services & Packages -->
			<div class="group">
				<div class="group-header" onclick="toggleGroup(this)">
					Services & Packages
					<i class="fa-solid fa-angle-down toggle-icon"></i>
				</div>
				<div class="group-content">
					<a href="/Category/CategoryList">Category</a>
					<a href="/Service/ServicesList">Service</a>
