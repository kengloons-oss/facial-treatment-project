				<a href="#" class="lang-switch" data-lang="en"><i class="fa-solid fa-globe"></i> English</a>
				<a href="#" class="lang-switch" data-lang="zh"><i class="fa-solid fa-globe"></i> 中文</a>
			</div> -->

		</div>

		<div class="sidebar-option sidebar-bottom">
			<a style="color: red;" href="/Login/Logout"> Logout <i class="fa-solid fa-arrow-right-from-bracket"></i></a>
		</div>
	</div>
	<!-- end staff Sidebar -->
	<!-- page name and breadcrumb -->
	<main class="adminsidebar">
		<div class="ad-head">
			<img src="/images/favicon.png" height="50" width="50" />
			<h3 style="margin:0;">OwO Meow Beauty - Admin Portal</h3>
		</div>

		<!-- breadcrumb -->
		<ul class="breadcrumb" style="margin:.5rem 0rem .5rem 0rem;">
			@if (ViewBag.Breadcrumbs != null)
			{
				foreach (var breadcrumb in (List<KeyValuePair<string, string>>)ViewBag.Breadcrumbs)
				{
					if (!string.IsNullOrEmpty(breadcrumb.Value))
					{
						// Render as a link if URL is not null
						<li class="breadcrumb-item">
							<a href="@breadcrumb.Value">@breadcrumb.Key</a>
						</li>
					}
					else
					{
						// Render as plain text if URL is null (current page)
						<li class="breadcrumb-item">
							@breadcrumb.Key
						</li>
					}
				}
			}
		</ul><!-- end breadcrumb -->
		<!-- end breadcrumb -->
		@RenderBody()
	</main>

	<!-- Footer -->
	<footer class="text-center">
