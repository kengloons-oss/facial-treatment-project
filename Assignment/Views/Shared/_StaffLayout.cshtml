<body style="width: 110%;">

	@if (TempData["Success_Title"] != null)
	{
		<script>
			Swal.fire({
				title: "@TempData["Success_Title"]",
				html: "@Html.Raw(TempData["Alert_Success"])", // Use Html.Raw to render the HTML content properly
				icon: "success",
				showDenyButton: false,
				showCancelButton: false,
				confirmButtonText: "OK",
			});
		</script>
	}
	else if (TempData["Error_Title"] != null)
	{
		<script>
			var error_title = "@TempData["Error_Title"]";
			Swal.fire({
				title: error_title,
				html: "@Html.Raw(TempData["Alert_Error"])", // Use Html.Raw here as well
				icon: "error",
				showDenyButton: false,
				showCancelButton: true,
				confirmButtonText: "OK",
			}).then((result) => {
				if(error_title == "Access Denied"){
					if(result.isConfirmed){
						window.location.href = "/Login/Login";
					}
					else {
						window.location.href = "/Home/Home";
					}
				}
			});
		</script>
	}

	<!-- staff Sidebar -->
	<button id="toggle-sidebar"><</button>
	<div class="sidebar">
		<div class="profile-box">
			<img src="@UserAvatar" height="60" width="60" style="margin-left: 12px; border: 1px solid #333;">
			<div>
				<h3 style="font-size: 1rem;">@User.UserName </h3>
				<span class="smalledit"><i class="fa-solid fa-user-pen"></i> <a href="/User/Profile">Edit Profile</a></span>
