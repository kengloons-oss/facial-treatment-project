	<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-beta.1/css/select2.min.css" rel="stylesheet" />
	<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

	@RenderSection("foot", false)


	<script>
		//BACK
		function back() {
			history.back();
		}

		function toggleGroup(header) {
			const group = header.parentElement;
			group.classList.toggle('open');
			// Toggle the shrunk class on the header for font size adjustment
			const headerElement = group.querySelector('.group-header');
			headerElement.classList.toggle('shrunk');
		}
	</script>
	<script>
		// Replace PHP variables with front-end equivalents
		var user_role = ''; // Replace with user role if needed
		var baseURL = ''; // Replace with your base URL if needed
		var lang = {}; // Replace with your language object as needed
		var sidebarOpen = false; // Default state for the sidebar

		// Initialize sidebar state
		if (!sidebarOpen) {
			$('#toggle-sidebar').css('left', '10px');
			$('.sidebar').addClass('closed');
			$('main').addClass('shrink');
			$('#toggle-sidebar').text('>');
		} else {
			$('#toggle-sidebar').css('left', '216px');
			$('.sidebar').removeClass('closed');
			$('main').removeClass('shrink');
			$('#toggle-sidebar').text('<');
		}

		// Toggle sidebar state
		$('#toggle-sidebar').click(function () {
			sidebarOpen = !sidebarOpen;

			if (sidebarOpen) {
				$('#toggle-sidebar').css('left', '216px');
				$('.sidebar').removeClass('closed');
				$('main').removeClass('shrink');
				$(this).text('<');
			} else {
				$('#toggle-sidebar').css('left', '10px');
				$('.sidebar').addClass('closed');
				$('main').addClass('shrink');
				$(this).text('>');
			}

			// Save sidebar state to localStorage
			localStorage.setItem('sidebarOpen', sidebarOpen ? '1' : '0');
		});

		// Restore sidebar state on page load
		$(document).ready(function () {

			// Initialize select2
			$('.select2').select2({
				allowClear: true,
				width: '100%' // Ensure full width
			});

			const storedSidebarState = localStorage.getItem('sidebarOpen');
			if (storedSidebarState === '1') {
				sidebarOpen = true;
				$('#toggle-sidebar').css('left', '216px');
				$('.sidebar').removeClass('closed');
				$('main').removeClass('shrink');
				$('#toggle-sidebar').text('<');
			} else {
				sidebarOpen = false;
				$('#toggle-sidebar').css('left', '10px');
				$('.sidebar').addClass('closed');
				$('main').addClass('shrink');
				$('#toggle-sidebar').text('>');
			}

			// Show loading alert when FullCalendar or Calendar is clicked
			$('.sidebar-option a[href="/Appointment/FullCalendar"], .sidebar-option a[href="/Appointment/Calendar"]').on('click', function (e) {
				e.preventDefault(); // Prevent the default navigation temporarily

				// Show loading spinner
				loadingAlert();

				// Proceed with navigation after showing the alert
				const href = $(this).attr('href');
				window.location.href = href;

			});
		});

		// Hover to display sidebar when closed
		$('.sidebar-option').hover(
			function () {
				if (!sidebarOpen) {
					$('#toggle-sidebar').css('left', '216px');
					$('.sidebar').removeClass('closed');
					$('main').removeClass('shrink');
				}
			},
			function () {
				if (!sidebarOpen) {
					$('#toggle-sidebar').css('left', '10px');
					$('.sidebar').addClass('closed');
					$('main').addClass('shrink');
				}
			}
		);

		// Handle language switch
		$('.lang-switch').on('click', function (e) {
			e.preventDefault();
			const selectedLang = $(this).data('lang');
			localStorage.setItem('lang', selectedLang);
			location.reload(); // Reload to apply changes if necessary
		});

		// Helper for translation
		function __(str) {
			return lang[str] || str; // Return translation if found, otherwise return original string
		}


		// Toggle language options
		$('#toggle-lang').click(function () {
			$('#lang-options').slideToggle();
			$('#lang-arrow').toggleClass('fa-angle-down fa-angle-up');
		});
		//Change Language Option
		$(document).ready(function () {
			$('.lang-switch').on('click', function (e) {
				e.preventDefault();

				// Get the clicked language text
				var selectedLanguage = $(this).find('span').text();

				// Update all `.lang-switch span` elements to show the selected language
				$('.lang-switch span').each(function () {
					var currentLang = $(this).text();
					$(this).text(currentLang === 'English' ? '中文' : 'English');
				});

				// (Optional) Log the selected language
				console.log('Selected Language:', selectedLanguage);
			});
		});
	</script>

</body>
</html>
