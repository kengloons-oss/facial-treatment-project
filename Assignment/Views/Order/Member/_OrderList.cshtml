@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Order>

@{
	string[] fields = ["ID", "Package Purchased", "Amount (RM)", "Payment Method", "Payment Date"];
	string json_categories = System.Text.Json.JsonSerializer.Serialize<int[]>(ViewBag.Selected_categories);
}

@Html.Hidden("sort", "", new { form = "f" })
@Html.Hidden("dir", "", new { form = "f" })
@Html.Hidden("page", "", new { form = "f" })

<div class="card-left-tb">
	@Model.Count() of @Model.TotalItemCount record(s) &nbsp;&nbsp;| &nbsp;
	Page @Model.PageNumber of @Model.PageCount
</div>

<table class="admin-table1">
	<thead>
		<tr>
			@foreach (var f in fields)
			{
				string dir = "asc";
				string sort = "";
				string sort_icon = "asc";

				if (f == ViewBag.Sort)
				{
					dir = ViewBag.Dir == "desc" ? "asc" : "desc";
					sort = ViewBag.Dir;
					sort_icon = dir == "asc" ? "fa-sort-up" : "fa-sort-down";
				}

				<th class="table_headers">
					<a data-ajax="true"
					   data-ajax-update="#target"
					   data-ajax-loading="#loader"
					   href="?payment_method=@ViewBag.Payment_method&service_categories=@json_categories&max_amt=@ViewBag.Max_amt&min_amt=@ViewBag.Min_amt&sort=@f&dir=@dir&page_items=@ViewBag.Page_items&page=@Model.PageNumber" class="@sort">
						@f<i class='fas @sort_icon'></i>
					</a>
				</th>
			}
			<th class="table_headers">Action</th>
		</tr>
	</thead>

	<tbody>
		@{
			if (Model.Count() == 0)
			{
				<tr>
					<td colspan="7">You haven't create any order yet.</td>
				</tr>
			}
			else
			{
				foreach (var o in Model)
				{
					<tr>
						<td>@o.Code</td>
						<td>@o.OrderPackages.Count()</td>
						<td>@o.Amount</td>
						<td>@Helpers.FormatPaymentMethod(o.Payment_method)</td>
						<td>@Helpers.FormatDate(o.Payment_date)</td>
						<td>
							<!-- Edit Button -->
							<button class="uk-button uk-button-default uk-button-small pastel-edit-btn" data-get="/Order/MemberDetail/@o.Id" uk-tooltip="View/ Edit This Details">
								<span uk-icon="pencil" class="uk-icon"></span> <span class="button-text">View</span>
							</button>
						</td>
					</tr>
				}
			}
		}
	</tbody>

	
</table>

<nav class="admin-pager">
	@{
		var options = PagedListRenderOptions.ClassicPlusFirstAndLast;
		options.LinkToFirstPageFormat = "<i class='fas fa-backward-fast'></i>";
		options.LinkToLastPageFormat = "<i class='fas fa-forward-fast'></i>";
		options.LinkToPreviousPageFormat = "<i class='fas fa-chevron-left'></i>";
		options.LinkToNextPageFormat = "<i class='fas fa-chevron-right'></i>";

		var ajaxOptions = new AjaxOptions
			{
				HttpMethod = "get",
				UpdateTargetId = "target",
				LoadingElementId = "#loader",
			};
	}

	@Html.PagedListPager(
		Model,
		p => $"?payment_method={ViewBag.Payment_method}&service_categories={json_categories}&max_amt={ViewBag.Max_amt}&min_amt={ViewBag.Min_amt}&sort={ViewBag.Sort}&dir={ViewBag.Dir}&page_items={@ViewBag.Page_items}&page={p}",
		PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(options, ajaxOptions)
	)
</nav>
