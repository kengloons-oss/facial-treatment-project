@using X.PagedList.Mvc.Core
@{
    Layout = "_StaffLayout";
    ViewBag.Title = "Service List";

    ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
    {
        new KeyValuePair<string, string>("Service", "/Service/ServiceList"),
        new KeyValuePair<string, string>("List", null)
    };

    var User = Helpers.GetUser();
}

@section head {
    <script src="/js/general/adminService.js"></script>
}

<form data-ajax="true"
      data-ajax-update="#target"
      data-ajax-loading="#loader"
      id="f">

    <div class="container-filter">
        <div class="half">
            <div class="card card-blue-shadow">
                <div class="card-txtfield card-body">
                  
                    <label for="min_expense">Price Range: </label>
                    <div class="uk-flex uk-flex-between uk-flex-middle uk-width-1-1">
                        <div class="uk-width-expand">
                            @Html.TextBox("priceStart", null, new { @type = "number", @class = "uk-width-1-1", @min = "0.01", @step = "0.01", placeholder = "Start amount for filter price range", @uk_tooltip = "title: Start amount for filter price range; pos: top-left;" })
                        </div>
                        <div class="uk-margin-small-left uk-margin-small-right uk-flex uk-flex-middle">
                            -
                        </div>
                        <div class="uk-width-expand">
                            @Html.TextBox("priceEnd", null, new { @type = "number", @class = "uk-width-1-1", @min = "0.01", @step = "0.01", placeholder = "End amount for filter price range", @uk_tooltip = "title: End range for filter price range; pos: top-left;" })
                        </div>
                    </div>

                    @* filter service category involved in package *@
                    <label for="filter_service_category">Service Category: </label>
                    <select id="filter_category" name="categoryId" asp-items="@ViewBag.CategoryList" class="select2"></select>

                    <label for="filter_status">Status: </label>
                    @Html.DropDownList("filter_status", Helpers.status_list, new { @class = "form-input" })

                    <label for="filter_pageitems">Items Per Page: </label>
                    @Html.DropDownList("page_items", Helpers.page_items, null, new { id = "filter_pageitems" })

                </div>
            </div>
        </div>
    </div>

    @if(Helpers.isManager()){
        <div class="card-button-right">
            <button data-get="/Service/Staff/CreateService" id="b_create">Create New Service</button>
        </div>
    }
    
    <div class="search-container card-right-tb">
        <div class="search-bar">
            @Html.TextBox("name", "",
                     new { type = "search", @class = "search-input", autofocus = "", placeholder = "Search Service Name Here..." })
            <button id="search-button"><i class="fas fa-search"></i></button>
        </div>
    </div>
</form>

<div id="target">
    <partial name="Staff/_ServiceList" />
</div>


<!-- Modal for selecting deactivated services -->
<div id="modal-id" class="modal">
    <a href="#close" class="modal-overlay" aria-label="Close"></a>

    <div class="modal-container">
        <div class="modal-header">
            <a href="#" class="btn btn-clear float-right" aria-label="Close"></a>
            <h3 class="modal-title">Reactivate Package(s) Contain This Service :</h3>
        </div>

        <div class="modal-body">
            <div id="reactivateservices-box" class="content">
                <!-- form checkbox control -->
                <div class="form-group">
                    <label class="form-checkbox">
                        <input type="checkbox" id="selectAllPackages">
                        <i class="form-icon"></i> Select All
                    </label>
                </div>

                <div class="form-group">
                    <label class="form-checkbox">
                        <!-- List of deactivated services -->
                        <div id="packageList"></div>
                    </label>
                </div>


            </div>
        </div>

        <div class="modal-footer">
            <button id="confirmPackageSelection" class="btn btn-primary">Activate Service Only</button>
        </div>
    </div>
</div>

@section foot {
    <script>
        let timer = null;

        $('#name, #priceStart, #priceEnd').on('input', e => {
            clearTimeout(timer);
            timer = setTimeout(() => $(e.target.form).submit(), 100);
        });

        $('#filter_category, #filter_pageitems').on('change', e => {
            $(e.target.form).submit();
        });

    </script>
}