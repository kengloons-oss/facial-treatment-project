@model CategoryVM
@{
    Layout = "_StaffLayout";
    ViewBag.Title = "Category | Create";

    // breadcrumb data
    ViewBag.Breadcrumbs = new List<KeyValuePair<string, string>>()
    {
        new KeyValuePair<string, string>("Category", "/Category/CategoryList"),
        new KeyValuePair<string, string>("Create", null)
    };

}

<form method="post" id="dynamicForm">
    <div class="container">
        <div class="columns">
            <!-- left-side -->
            <div class="formformat column col-6 col-sm-12 card my-single-card">

                <div class="card-header">
                    <div class="card-title h5">
                        <!-- Back Button -->
                        <button class="topleft-back" type="button" data-get="/Category/CategoryList" uk-tooltip="title: Back to Previous Section; pos: top-left;"><i class="fa-solid fa-arrow-left"></i></button> &nbsp;
                        <!-- Page Title -->
                        Create Category
                    </div>
                </div>

                <div class="card-body my-pagecard-body">
                    <!-- Name -->
					<div class="form-group">
                        <label for="Name" class="form-label">Name: </label>
						<input type="text" name="Name" class="form-input name" />
                        <span asp-validation-for="Name" class="form-input-hint error-message"></span>
					</div>

                    <!-- Description -->
					<div class="form-group">
						<label for="Description">Description: </label>
                        <textarea name="Description" class="form-input description" /></textarea>
                        <span asp-validation-for="Description" class="form-input-hint error-message"></span>
					</div>

                    <!-- Buttons -->
                    <div class="text-right" style="padding-top:16px;">
                        <button type="reset" class="btn btn-secondary">Reset</button>
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
